{
  "name": "buzz-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "preview": "node ./server/index.mjs",
    "test": "node --test ./server/*.test.mjs && vitest run src/domain src/data src/ui/Timeline.test.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm test && pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
